    #
    # generate_plot(logits_cen, logits_fl)

    # Convert the list of numpy.ndarrays to a single numpy.ndarray
    logits_cen = np.array(logits_cen)
    logits_fl = np.array(logits_fl)

    # Convert the numpy.ndarray to a PyTorch tensor
    logits_cen = torch.tensor(logits_cen)
    logits_fl = torch.tensor(logits_fl)

    # Reshape the tensors to combine height and width dimensions, ignoring the batch dimension
    logits_cen = logits_cen.view(logits_cen.size(0), logits_cen.size(2), -1)
    logits_fl = logits_fl.view(logits_fl.size(0), logits_fl.size(2), -1)

    generate_plot(logits_cen, logits_fl)
